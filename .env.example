# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Clerk URLs (optional - defaults work for most cases)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Edge Functions 自部署地址（可选，不设置则使用 SUPABASE_URL/functions/v1）
# NEXT_PUBLIC_EDGE_FUNCTIONS_URL=https://lovlzdeno.robbanaititle.com

# Image Generation API
IMAGE_API_BASE_URL=your_image_api_base_url
IMAGE_API_KEY=your_image_api_key

# X.AI Grok API
XAI_API_KEY=your_grok_api_key

# Video Generation API (ClockAPI)
VIDEO_API_BASE_URL=your_video_api_base_url
VIDEO_API_KEY=your_video_api_key

# ImgBB Image Upload API (use imgbb.com/json endpoint)
NEXT_PUBLIC_IMGBB_PHPSESSID=your_phpsessid_cookie_value
NEXT_PUBLIC_IMGBB_AUTH_TOKEN=your_auth_token_value

# Next.js allowed dev origins (comma-separated, for cross-origin dev access)
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=your-custom-domain.com
